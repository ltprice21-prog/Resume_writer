# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. How hard Claude works on each tailoring pass.
# low | medium | high | xhigh | max  (default: medium)
# Higher = better writing, more tokens, slower. "high" is worth trying if you
# find the output too safe; "low" if you're iterating on many postings quickly.
TAILOR_EFFORT=medium
